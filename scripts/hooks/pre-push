#!/bin/sh
# Local gate before a push. Two jobs: keep direct pushes off the protected
# branch, and run the checks CI will run anyway — failing here costs seconds,
# failing in CI costs a round trip.
#
# Install: cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

protected_branch="main"
current_branch=$(git symbolic-ref HEAD 2>/dev/null | sed 's|refs/heads/||')

if [ "$current_branch" = "$protected_branch" ]; then
  echo ""
  echo "  Direct push to '$protected_branch' is not allowed."
  echo "  Create a branch and open a Pull Request instead."
  echo ""
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "  pre-push: node_modules missing, skipping checks (CI will still run them)."
  exit 0
fi

fail() {
  echo ""
  echo "  $1"
  echo "  Push aborted. Fix it, or re-run with --no-verify if you know better."
  echo ""
  exit 1
}

npm run --silent lint || fail "eslint failed."
npm run --silent test || fail "vitest failed."

# The generated client must match the committed contract. Drift here compiles
# fine and fails at runtime against a server that no longer honours it, so CI
# gates on it — catch it locally instead.
npm run --silent generate:api >/dev/null 2>&1
if ! git diff --quiet -- lib/api/schema.d.ts; then
  git checkout -- lib/api/schema.d.ts
  fail "lib/api/schema.d.ts is stale — run 'npm run generate:api' and commit it."
fi

# next build is the typecheck gate: tsc --noEmit alone fails on Next's
# generated route types (LayoutProps et al), which only exist after a build.
npm run --silent build >/dev/null || fail "next build failed (this is also the typecheck gate)."

exit 0
