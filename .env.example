# Lyra — web client for the Prediction Market Intelligence Engine
# Copy to `.env.local` and adjust. `.env.local` is gitignored.

# Base URL of the Cygnus API (Layers 3-5).
#
# Deliberately NOT prefixed NEXT_PUBLIC_: the browser talks to this app's own
# /api routes, which proxy to Cygnus server-side. That keeps the API address —
# and any auth header added in Phase 3 — out of the client bundle. The browser
# must never reach Gemini, MCP, or Sagittarius directly.
CYGNUS_API_URL=http://127.0.0.1:8000

# Supabase project used for auth (B.16). Same project Cygnus verifies tokens
# against — its SUPABASE_URL there must match this one.
#
# NEXT_PUBLIC_ here is correct, not an oversight: these are Supabase's
# publishable anon key and project URL, meant to sit in the browser bundle.
# Access control is enforced by Cygnus (JWKS-verified bearer tokens) and by
# Supabase's own row-level security, never by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
